# ==============================================================================
# OptimumERP - Environment Variables Template
# Only contains variables defined in backend/src/config.js.
# Copy this file to '.env' and fill in the values.
# ==============================================================================

# ==============================================================================
# 1. ABSOLUTELY REQUIRED VARIABLES (No default fallbacks)
# ==============================================================================

# Encryption secret for sensitive data (e.g. 64-character random string)
CRYPTO_SECRET=v9y$B&E)H@McQfTjWnZr4u7x!A%C*F-JaNdRgUkXp2s5v8y/B?E(G+KbPeShVmYq

# Encryption algorithm (e.g., aes-256-cbc)
CRYPTO_ALGORITHM=aes-256-cbc

# Encryption hash algorithm (e.g., sha256)
CRYPTO_HASH_ALGORITHM=sha256

# MongoDB connection string (replicaSet=rs0 is required for transaction support)
MONGO_URI=mongodb://localhost:27017/mydb?replicaSet=rs0

# Frontend application URL
VITE_APP_URL=http://localhost:5173

# Backend API server URL
VITE_API_URL=http://localhost:3000

# Directory path for organization storage (logos, avatars, CSV uploads)
NETWORK_STORAGE_PATH=/home/atul/Storage

# Secret for signing session cookies
SESSION_SECRET=your_session_secret_here


# ==============================================================================
# 2. NOT REQUIRED VARIABLES (Optional / Defaults provided if omitted)
# ==============================================================================

# Node environment (development, production, testing - default: development)
NODE_ENV=development

# Port the backend server listens on (default: 3000)
PORT=3000

# File path for structured log files (if empty, logs to console)
LOG_FILE_PATH=

# Cron schedule for processing batch imports (default: every 5 seconds)
IMPORT_CRON_SCHEDULE=*/5 * * * * *

# Cron schedule for generating recurring invoices (default: every 15 minutes)
RECURRING_INVOICES_CRON=*/15 * * * *

# Host URL for local Ollama AI instance
OLLAMA_HOST=http://localhost:11434

# Host URL for Grok AI instance
GROK_HOST=

# SMTP host for outbound emails/OTP
NODE_MAILER_HOST=smtp.gmail.com

# SMTP username
NODE_MAILER_USER_NAME=your_email@gmail.com

# SMTP app password
NODE_MAILER_APP_PASSWORD=your_app_password

# SMTP sender email address
NODE_MAILER_EMAIL=your_email@gmail.com

# SMTP port (default: 587)
NODE_MAILER_PORT=587

# Enable/disable cache (default: true)
CACHE_ENABLED=true

# Session lifetime in milliseconds (default: 5 days)
SESSION_AGE=432000000

# Default subscription plan for new users (free, gold, platinum - default: free)
DEFAULT_USER_PLAN=free

# --- Cache TTL (Time-To-Live) configurations in seconds ---

# EJS email/document template cache TTL (default: 600)
TEMPLATE_CACHE_TTL_SECONDS=600

# Default system cache TTL (default: 300)
CACHE_DEFAULT_TTL_SECONDS=300

# Cache check period to purge expired keys (default: 120)
CACHE_CHECK_PERIOD_SECONDS=120

# Unit of Measure cache TTL (default: 1800)
UM_CACHE_TTL_SECONDS=1800

# Tax configuration cache TTL (default: 600)
TAX_CACHE_TTL_SECONDS=600

# Settings display cache TTL (default: 600)
SETTING_DISPLAY_CACHE_TTL_SECONDS=600

# Detailed settings cache TTL (default: 600)
SETTING_DETAILED_CACHE_TTL_SECONDS=600

# Product category list cache TTL (default: 1200)
PRODUCT_CATEGORY_CACHE_TTL_SECONDS=1200

# Expense category list cache TTL (default: 1200)
EXPENSE_CATEGORY_CACHE_TTL_SECONDS=1200
